{
  "expo": {
    "name": "styever",
    "slug": "styever",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A4A32"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.styever.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A4A32"
      },
      "package": "com.styever.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "newArchEnabled": true,
    "owner": "barisozluk",
    "extra": {
      "eas": {
        "projectId": "0698e660-9c38-4199-a0b9-3c9f9d6e5213"
      }
    }
  }
}
